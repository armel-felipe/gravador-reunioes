{
  "manifest_version": 3,
  "name": "Gravador de Reuniões",
  "version": "0.1.0",
  "description": "Grava o áudio da aba + microfone e envia para o servidor local de transcrição.",
  "permissions": ["tabCapture", "activeTab", "storage", "offscreen", "scripting", "nativeMessaging"],
  "host_permissions": ["http://127.0.0.1:8765/*", "ws://127.0.0.1:8765/*", "<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["toaster-lifecycle.js", "toaster-content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": "icons/icon.png",
    "default_popup": "popup.html",
    "default_title": "Gravador de Reuniões"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  }
}
