# Copie este arquivo para .env e preencha com seus valores.
# O .env NÃO é versionado (está no .gitignore) — nunca commite tokens.

# API key do OpenRouter (necessária somente quando ollama.provider = "openrouter")
OPENROUTER_API_KEY=

# Token de acesso do HuggingFace (criar em https://huggingface.co/settings/tokens)
# Necessário para baixar os modelos de diarização (pyannote).
HUGGINGFACE_TOKEN=hf_cole_seu_token_aqui
